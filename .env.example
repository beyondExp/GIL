# Copy to .env. Never commit real tokens.

# --- Controls ---
GIL_HUMANOID_BACKEND=sim_ws
GIL_USE_ROS2=0
GIL_REQUIRE_MOTION_ENABLE=1
GIL_STATE_STALE_AFTER_S=1.5
GIL_HEARTBEAT_TIMEOUT_S=2.0
GIL_MAX_VX=0.6
GIL_MAX_VY=0.4
GIL_MAX_WZ=1.0

# --- Auth (required for hardware / autonomy) ---
GIL_OPERATOR_TOKEN=
GIL_AUTONOMY_TOKEN=

# --- Models (optional) ---
GOOGLE_API_KEY=
GIL_ALLOW_ESTIMATED_OBJECT_COORDINATES=0

# --- Isaac Sim (pip install lives on E: by default) ---
ISAACSIM_PATH=E:\GIL\isaacsim
OMNI_USER_CACHE=E:\GIL\isaacsim-cache
HF_HOME=E:\hf_home
GIL_HF_WORLD_CACHE=E:\GIL\hf-worlds

# --- Logging ---
GIL_LOG_LEVEL=INFO
GIL_EVENT_LOG_PATH=gil_controls/logs/humanoid_events.jsonl

# --- Memory (optional) ---
# Neo4j-backed spatial/semantic memory (scene graph)
GIL_NEO4J_ENABLED=0
GIL_NEO4J_URI=neo4j://127.0.0.1:7687
GIL_NEO4J_USER=neo4j
GIL_NEO4J_PASSWORD=
GIL_NEO4J_DATABASE=neo4j
