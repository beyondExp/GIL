# MCP Environment Variables Configuration
# Copy this file to .env and fill in your values
# Don't commit .env to version control!

# ============================================================================
# API Configuration
# ============================================================================

# Google Gemini API Key (for robot LLM control)
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Hugging Face API Token (optional for public models, required for private)
# Get token from: https://huggingface.co/settings/tokens
MCP_API_HUGGINGFACE_TOKEN=

# API request timeout in seconds
# MCP_API_TIMEOUT=30


# ============================================================================
# Model Configuration
# ============================================================================

# Default task when not specified
# Options: text-generation, sentiment-analysis, object-detection, etc.
# MCP_MODEL_DEFAULT_TASK=object-detection

# Minimum number of downloads for model filtering
# MCP_MODEL_MIN_DOWNLOADS=1000

# Directory to cache downloaded models
# Default: ~/.cache/huggingface
# MCP_MODEL_CACHE_DIR=/path/to/model/cache


# ============================================================================
# Execution Configuration
# ============================================================================

# Device to run models on
# Options: cpu, cuda (NVIDIA GPU), mps (Apple Silicon)
MCP_EXECUTION_DEVICE=cpu

# Batch size for processing
# MCP_EXECUTION_BATCH_SIZE=1

# Enable FP16 (half-precision) for faster GPU inference
# Options: true, false, 1, 0, yes, no
# MCP_EXECUTION_ENABLE_FP16=false


# ============================================================================
# Logging Configuration
# ============================================================================

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOGGING_LEVEL=INFO

# Directory for log files
# MCP_LOGGING_DIR=logs


# ============================================================================
# Metrics Configuration
# ============================================================================

# Enable performance metrics tracking
# Options: true, false, 1, 0, yes, no
# MCP_METRICS_ENABLE=true


# ============================================================================
# Example Configurations
# ============================================================================

# Development (CPU, verbose logging):
# MCP_EXECUTION_DEVICE=cpu
# MCP_LOGGING_LEVEL=DEBUG
# MCP_METRICS_ENABLE=true

# Production (GPU, optimized):
# MCP_API_HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx
# MCP_EXECUTION_DEVICE=cuda
# MCP_EXECUTION_ENABLE_FP16=true
# MCP_LOGGING_LEVEL=WARNING
# MCP_MODEL_MIN_DOWNLOADS=10000
# MCP_METRICS_ENABLE=true

# Testing (minimal setup):
# MCP_EXECUTION_DEVICE=cpu
# MCP_LOGGING_LEVEL=ERROR


